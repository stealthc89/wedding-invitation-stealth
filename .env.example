# Admin credentials (used to seed the first admin user)
ADMIN_EMAIL=admin@wedding.com
ADMIN_PASSWORD=change-me-please

# JWT secret for admin sessions
JWT_SECRET=generate-a-random-string-here

# Base URL of the site (used in email links)
BASE_URL=https://your-wedding-domain.com

# SMTP configuration (example: Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
EMAIL_FROM=wedding@yourdomain.com
